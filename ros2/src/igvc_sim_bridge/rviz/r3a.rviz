        base_link:
          Value: true
        camera_color_optical_frame:
          Value: true
        camera_link:
          Value: true
        camera_mount_link:
          Value: true
        left_caster:
          Value: true
        lidar_link:
          Value: true
        odom:
          Value: true
        right_caster:
          Value: true
        wheel_left:
          Value: true
        wheel_right:
          Value: true
