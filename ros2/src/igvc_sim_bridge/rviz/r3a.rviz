      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: false
      Tree:
        odom:
          base_footprint:
            base_link:
              camera_mount_link:
                camera_link:
                  camera_color_optical_frame:
                    {}
              left_caster:
                {}
              lidar_link:
                {}
              right_caster:
                {}
              wheel_left:
                {}
              wheel_right:
                {}
      Update Interval: 0
      Value: true
    - Alpha: 1
